
---

# `.gitignore`

```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/

# Testing files
*.pdf
*.docx
*.txt

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/

# Python packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/